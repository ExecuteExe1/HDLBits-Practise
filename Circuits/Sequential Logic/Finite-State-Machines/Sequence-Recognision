module top_module(
    input clk,
    input reset,    // Synchronous reset
    input in,
    output disc,
    output flag,
    output err);

    localparam [3:0] ZERO =0,ONE=1,TWO=2,THREE=3,FOUR=4,FIVE=5,SIX=6,DISC=7,FLAG=8,ERR=9;
    reg [3:0] state,next_state;

    always@(*)begin
        case(state)
            ZERO:next_state=(in)?ONE:ZERO;
            ONE:next_state=(in)?TWO:ZERO;
            TWO:next_state=(in)?THREE:ZERO;
            THREE:next_state=(in)?FOUR:ZERO;
            FOUR:next_state=(in)?FIVE:ZERO;
                FIVE:next_state=(in)?SIX:DISC;
            SIX:next_state=(in)?ERR:FLAG;
            DISC:next_state=(in)? ONE : ZERO;
            FLAG:next_state=(in)?ONE : ZERO;
            ERR:next_state=(in)?ERR : ZERO;
        endcase
    end

    always@(posedge clk)begin
        if(reset) state <= ZERO;
        else state <= next_state;
    end

    assign disc = (state==DISC);
    assign flag = (state==FLAG);
    assign err = (state==ERR);


endmodule



endmodule
