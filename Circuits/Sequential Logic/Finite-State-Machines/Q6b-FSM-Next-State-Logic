module top_module (
    input [3:1] y,
    input w,
    output Y2);

    reg [3:1] Y;

    always@(*)begin
        case({y, w})
          4'b0000: Y=3'b001; //A w=0
          4'b0001: Y=3'b000; //A w=1
          4'b0010: Y=3'b010; //B w=0
          4'b0011: Y=3'b011; //B  w=1
          4'b0100: Y=3'b100; //C w=0
          4'b0101: Y=3'b011; //C  w=1
          4'b0110: Y=3'b101; //D w=0
          4'b0111: Y=3'b000; //D  w=1
          4'b1000: Y=3'b100; //E w=0
          4'b1001: Y=3'b011; //E w=1
          4'b1010: Y=3'b010; //F w=0
          4'b1011: Y=3'b011; //F w=1
              endcase
              end

               assign Y2 = Y[2];

endmodule
